{
  "name": "harness-gemini-development",
  "version": "1.4.4",
  "private": true,
  "type": "module",
  "description": "Development and packaging tools for Harness Gemini 1.4.4",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "start": "node tools/run.mjs server",
    "desktop": "node tools/run.mjs desktop",
    "smoke:desktop": "node tools/run.mjs smoke",
    "check": "node tools/check-source.mjs",
    "verify:release": "node tools/verify-release.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:win": "electron-builder --config electron-builder.json --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.18.0",
    "rcedit": "4.0.1"
  }
}
